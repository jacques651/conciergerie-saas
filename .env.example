# --- Serveur ---
PORT=4000
JWT_SECRET=change-moi-en-production
CLIENT_ORIGIN=http://localhost:5173
# Production : NODE_ENV=production, JWT_SECRET de 32 caractères minimum, DB_PATH absolu (disque persistant)
# Compte admin initial créé au démarrage s'il n'existe pas (production)
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Origines autorisées (CORS) en production, séparées par des virgules
# CORS_ALLOW_VERCEL_PREVIEWS=true pour autoriser les prévisualisations *.vercel.app
DB_PATH=./data.sqlite

# --- Abonnement ---
# Tarifs : configurables par l admin (table settings, onglet « Configuration des tarifs »)
SUBSCRIPTION_CURRENCY=XOF

# --- Paiement Mobile Money : FedaPay (https://docs.fedapay.com) ---
# Sans FEDAPAY_SECRET_KEY → paiement simulé (développement). Avec la clé → vraies transactions.
# FEDAPAY_ENVIRONMENT : sandbox (tests, aucun argent réel) ou live (production)
FEDAPAY_ENVIRONMENT=sandbox
FEDAPAY_SECRET_KEY=
FEDAPAY_PUBLIC_KEY=
# Secret du webhook (Workbench > Webhooks > « Click to reveal »), commence par wh_sandbox_ / wh_live_
FEDAPAY_WEBHOOK_SECRET=
# URL du frontend : page de retour après paiement (FedaPay redirige vers FRONTEND_URL/abonnement)
FRONTEND_URL=https://localhost:5173
# Forcer le fournisseur (facultatif) : fedapay | simulated
PAYMENT_PROVIDER=

# --- Client (Vite) ---
# VITE_API_URL se règle dans client/.env.production (ou dans Vercel), pas ici.
